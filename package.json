{
  "name": "waymark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/convex-local.mjs dev --start \"node scripts/convex-local.mjs run fixtures:seed && npm run dev:web\"",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "npm run lint:fix && prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc -b && tsc --noEmit -p convex/tsconfig.json",
    "test": "npm run test:contracts && npm run test:convex",
    "dev:web": "vite",
    "test:browser": "playwright test",
    "dev:backend": "node scripts/convex-local.mjs dev --run fixtures:seed",
    "setup:local": "node scripts/convex-local.mjs dev --once",
    "test:contracts": "tsx --test tests/*.test.ts",
    "test:convex": "vitest run",
    "demo:scenario": "node scripts/convex-local.mjs run fixtures:setScenario",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "convex": "^1.45.0",
    "lucide-react": "^1.43.0",
    "playwright": "^1.63.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.3",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/cli": "^0.1.19",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "convex-test": "^0.0.57",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
